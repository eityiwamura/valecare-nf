# Conexão com o PostgreSQL (no EasyPanel, use o hostname interno do serviço de banco,
# ex: postgresql://usuario:senha@NUMERO_nome-servico:5432/nomedb)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/valecare_nf
DATABASE_SSL=false

# Porta em que o servidor Express vai escutar
PORT=3000

# Segredo usado para assinar o cookie de sessão — troque por um valor aleatório longo em produção
SESSION_SECRET=troque-este-valor-por-algo-aleatorio-e-longo

# Ambiente
NODE_ENV=production
# Defina como true quando estiver atrás de HTTPS (Traefik/EasyPanel) para cookies seguros
COOKIE_SECURE=true

# Usado apenas pelo script "npm run seed" para criar/atualizar o usuário administrador
ADMIN_USERNAME=eity
ADMIN_PASSWORD=defina-uma-senha-forte-aqui
