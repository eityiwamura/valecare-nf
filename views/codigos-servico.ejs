<%- include('partials/head', { title: 'Códigos de Serviço' }) %>

<div class="page-header">
  <div>
    <h1>Códigos de Serviço</h1>
    <p>Cadastre os códigos de serviço (NFS-e) de cada empresa para usar no lançamento manual de NF.</p>
  </div>
</div>

<% if (erro) { %>
  <div class="alert alert-error"><%= erro %></div>
<% } %>
<% if (sucesso) { %>
  <div class="alert alert-success">Código de serviço salvo com sucesso!</div>
<% } %>

<div class="grid cols-2" style="align-items:start;">
  <div class="card">
    <h3 style="margin-top:0;">Novo código</h3>
    <form method="POST" action="/codigos-servico">
      <div class="field">
        <label for="empresaId">Empresa</label>
        <select name="empresaId" id="empresaId" required>
          <option value="">Selecione...</option>
          <% empresas.forEach(function(e){ %>
            <option value="<%= e.id %>"><%= e.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="codigo">Código</label>
        <input type="text" name="codigo" id="codigo" placeholder="Ex: 4.01" required />
      </div>
      <div class="field">
        <label for="descricao">Descrição</label>
        <input type="text" name="descricao" id="descricao" placeholder="Ex: Medicina e biomedicina" />
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%;">Salvar código</button>
    </form>
  </div>

  <div class="card" style="padding:0; overflow-x:auto;">
    <% if (!codigos.length) { %>
      <div class="empty-state">
        <div class="icon">🏷️</div>
        <div>Nenhum código cadastrado ainda.</div>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Empresa</th>
            <th>Código</th>
            <th>Descrição</th>
            <th style="width:40px;"></th>
          </tr>
        </thead>
        <tbody>
          <% codigos.forEach(function(c){ %>
          <tr data-codigo-id="<%= c.id %>">
            <td class="text-col"><%= c.empresa_nome %></td>
            <td class="text-col" style="font-family:var(--font-mono); font-weight:700;"><%= c.codigo %></td>
            <td class="text-col"><%= c.descricao || '-' %></td>
            <td>
              <button type="button" class="codigo-delete-btn" data-id="<%= c.id %>" title="Excluir"
                style="background:none; border:none; cursor:pointer; color:var(--text-muted); font-size:15px;">🗑</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script>
  document.querySelectorAll('.codigo-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Excluir este código de serviço?')) return;
      const id = btn.dataset.id;
      const resp = await fetch('/codigos-servico/excluir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await resp.json();
      if (resp.ok && data.ok) {
        window.location.reload();
      } else {
        alert(data.erro || 'Erro ao excluir.');
      }
    });
  });
</script>

<%- include('partials/foot') %>
