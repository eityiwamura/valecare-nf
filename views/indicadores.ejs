<%- include('partials/head', { title: 'Indicadores de Operação' }) %>

<div class="page-header">
  <div>
    <p style="margin:0 0 4px; font-size:13px; color:var(--text-muted);">
      <a href="/codigos-servico" style="color:var(--primary);">Códigos de Serviço</a> ›
      <a href="/codigos-servico/<%= nbs.codigo_servico_id %>/nbs" style="color:var(--primary);"><%= nbs.codigo_servico_codigo %></a> ›
      NBS <%= nbs.codigo %>
    </p>
    <h1>Indicadores de Operação — <%= nbs.codigo %><% if (nbs.descricao) { %> <span style="color:var(--text-muted); font-weight:500;">(<%= nbs.descricao %>)</span><% } %></h1>
    <p>Cadastre os indicadores de operação vinculados a este NBS.</p>
  </div>
  <button type="button" class="btn btn-primary" onclick="abrirModal('modal-indicador')">+ Novo indicador</button>
</div>

<% if (erro) { %>
  <div class="alert alert-error"><%= erro %></div>
<% } %>

<div class="card" style="padding:0; overflow-x:auto;">
  <% if (!indicadores.length) { %>
    <div class="empty-state">
      <div class="icon">🏷️</div>
      <div>Nenhum indicador cadastrado para este NBS ainda.</div>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Descrição</th>
          <th>Classificações</th>
          <th style="width:40px;"></th>
        </tr>
      </thead>
      <tbody>
        <% indicadores.forEach(function(i){ %>
        <tr data-indicador-id="<%= i.id %>">
          <td class="text-col" style="font-family:var(--font-mono); font-weight:700;"><%= i.codigo %></td>
          <td class="text-col"><%= i.descricao || '-' %></td>
          <td class="text-col">
            <a href="/indicadores/<%= i.id %>/classificacoes" style="color:var(--primary); text-decoration:underline;">
              <%= i.total_classificacoes %> classificação(ões) →
            </a>
          </td>
          <td>
            <button type="button" class="indicador-delete-btn" data-id="<%= i.id %>" title="Excluir"
              style="background:none; border:none; cursor:pointer; color:var(--text-muted); font-size:15px;">🗑</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- Modal de novo indicador -->
<div class="modal-overlay" id="modal-indicador">
  <div class="modal-box" style="max-width:440px;">
    <div class="modal-header">
      <h3>Novo indicador de operação</h3>
      <button type="button" class="modal-close" onclick="fecharModal('modal-indicador')">✕</button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="m-codigo">Código do indicador</label>
        <input type="text" id="m-codigo" placeholder="Ex: 1" required />
      </div>
      <div class="field">
        <label for="m-descricao">Descrição</label>
        <input type="text" id="m-descricao" placeholder="Ex: Tributação no município do prestador" />
      </div>
      <div id="modal-indicador-status" class="modal-status" style="color:var(--tax);"></div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-ghost" onclick="fecharModal('modal-indicador')">Cancelar</button>
      <button type="button" class="btn btn-primary" id="btn-salvar-indicador">Salvar indicador</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.indicador-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Excluir este indicador? Isso também remove as classificações tributárias vinculadas a ele.')) return;
      const id = btn.dataset.id;
      const resp = await fetch('/indicadores/excluir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await resp.json();
      if (resp.ok && data.ok) window.location.reload();
      else alert(data.erro || 'Erro ao excluir.');
    });
  });

  document.getElementById('btn-salvar-indicador').addEventListener('click', async () => {
    const statusEl = document.getElementById('modal-indicador-status');
    const btn = document.getElementById('btn-salvar-indicador');
    const codigo = document.getElementById('m-codigo').value;
    const descricao = document.getElementById('m-descricao').value;
    if (!codigo) {
      statusEl.textContent = 'Informe o código do indicador.';
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Salvando...';
    try {
      const resp = await fetch('/indicadores', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nbsId: <%= nbs.id %>, codigo, descricao })
      });
      const data = await resp.json();
      if (resp.ok && data.ok) {
        window.location.reload();
      } else {
        statusEl.textContent = data.erro || 'Erro ao salvar.';
      }
    } catch (e) {
      statusEl.textContent = 'Erro de conexão.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Salvar indicador';
    }
  });
</script>

<%- include('partials/foot') %>
